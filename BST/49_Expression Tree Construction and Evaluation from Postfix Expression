#include <iostream>
using namespace std;

struct bstnode{
    char data;
    bstnode* lc,*rc;
};

void create(bstnode* &root,char k){
    if(root==NULL){
        root=new bstnode;
        root->data=k;
        root->lc=NULL;
        root->rc=NULL;
        return ;
    }
    if(k>root->data)
        create(root->rc,k);
    else
        create(root->lc,k);
}

struct stack{
    int top=-1;
    bstnode* arr[50];
}st;

void push(stack&s,bstnode*root){
    if(s.top>=49)return;
    s.top++;
    s.arr[s.top]=root;
}

bstnode* pop(stack&s){
    if(s.top==-1)return NULL;
    bstnode* temp=s.arr[s.top];
    s.top--;
    return temp;
}

bool isoperator(char c){   // checks if character is an operator
    if(c=='-'||c=='+'||c=='*'||c=='/'){
        return true;
    }
    return false;
}

bool isNum(char c){        // checks if character is a digit
    if(c>='0'&&c<='9'){
        return true;
    }
    return false;
}

bstnode* func(string s,stack&st){
    bstnode*root=NULL;
    bstnode *temp=NULL;

    for(int i=0;i<s.length();i++){
        if(isNum(s[i])){           // operand → create node and push
            temp=NULL;
            create(temp,s[i]);
            push(st,temp);
        }
        else if(isoperator(s[i])){ // operator → pop two operands and form subtree
            temp=NULL;
            create(temp,s[i]);

            bstnode* r=pop(st);
            bstnode *l=pop(st);

            temp->lc=l;
            temp->rc=r;

            push(st,temp);
        }
    }
    return pop(st); // final root of expression tree
}

int operation(int l, char optr,int r){   // performs arithmetic operation
    if(optr=='+'){
        return (l)+(r);
    }
    if(optr=='-')return(l)-(r);
    if(optr=='*')return (l)*(r);
    if(optr=='/')return(l)/(r);
}

int evaluation(bstnode* root){
    if(isoperator(root->data)){   // evaluate left and right subtrees
        int l=evaluation(root->lc);
        int r=evaluation(root->rc);
        return operation(l,root->data,r);
    }
    else{
        if(isNum(root->data)){    // leaf node (operand)
            return root->data-'0';
        }
    }
}

int main(){
    string s;
    cin>>s;

    bstnode* root=func(s,st); // build expression tree from postfix

    cout<<evaluation(root);   // evaluate expression

    return 0;
}
